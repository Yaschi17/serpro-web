# Variables de entorno en el servidor (NO subir secretos a GitHub)
# Copia a .env en /home/serpro/serpro-web

NODE_ENV=production
PORT=3000

# Token del túnel Cloudflare (Zero Trust → Networks → Tunnels)
# Dejar vacío hasta configurar el túnel; luego:
# docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
